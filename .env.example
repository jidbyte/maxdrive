# App 
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SEO (optional)
# Set to "false" to serve a robots.txt that blocks all crawlers (staging).
# Vercel preview deployments are always blocked automatically.
ALLOW_INDEXING=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Database (Neon Postgres)
DATABASE_URL=

# Firebase Auth — client (public)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin — server (secret)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the key with literal \n sequences; the app converts them.
FIREBASE_PRIVATE_KEY=
SESSION_COOKIE_DAYS=7

# Paystack
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Cloudflare R2 (product images)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_LANGUAGE_CODE=en
WHATSAPP_TEMPLATE_ORDER_CONFIRMATION_BUYER=
WHATSAPP_TEMPLATE_NEW_ORDER_SHOP_OWNER=
WHATSAPP_TEMPLATE_INVOICE_READY=

# AI product descriptions (OpenRouter)
OPENROUTER_API_KEY=

# Observability / jobs / rate limiting (wired in Phase 8) 
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
